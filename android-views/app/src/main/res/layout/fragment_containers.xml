<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sección 6: Contenedores y Estructura"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textColor="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Esquemas organizacionales para posicionar y orquestar elementos en el plano bidimensional (filas, columnas, superposiciones y restricciones)."
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 1. Fila, Columna y Superposición -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Distribución en Fila, Columna y Superposición"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="LinearLayout horizontal alinea en fila, vertical en columna, y FrameLayout apila vistas una sobre otra a lo largo del eje Z."
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                <!-- Ejemplo Fila -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distribución en Fila (Horizontal):"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="6dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@color/primary_container"
                        android:gravity="center"
                        android:text="Fila 1"
                        android:textColor="@color/on_primary_container" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@color/secondary_container"
                        android:gravity="center"
                        android:text="Fila 2"
                        android:textColor="@color/on_secondary_container" />
                </LinearLayout>

                <!-- Ejemplo Superposición (FrameLayout) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Distribución Superpuesta (FrameLayout / Stack):"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/surface_variant">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Capa Inferior Base"
                        android:textColor="@color/on_surface_variant" />
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:text="Capa Flotante"
                        style="@style/Widget.Material3.Button.TonalButton" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Pesos Proporcionales y Restricciones -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Pesos Proporcionales (layout_weight) y ConstraintLayout"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="Permite dividir el espacio de pantalla en proporciones relativas (1:2:1) o mediante anclajes relativos de bordes flexibles."
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/primary"
                        android:gravity="center"
                        android:text="Peso 1 (25%)"
                        android:textColor="@android:color/white" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:layout_marginStart="4dp"
                        android:background="@color/secondary"
                        android:gravity="center"
                        android:text="Peso 2 (50%)"
                        android:textColor="@android:color/white" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@color/tertiary"
                        android:gravity="center"
                        android:text="Peso 1 (25%)"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <!-- Demostración de ConstraintLayout -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/surface_variant">

                    <TextView
                        android:id="@+id/tvConstraintLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anclado Izquierda"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginStart="16dp" />

                    <TextView
                        android:id="@+id/tvConstraintCenter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Centrado Dinámico"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvConstraintRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anclado Derecha"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginEnd="16dp" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Barra Superior y Barra Inferior Demostrativas -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Barras de Estructura: Superior (TopAppBar) e Inferior (BottomNav)"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="La barra superior expone la identidad y acciones globales; la barra inferior o el cajón lateral (Drawer) orquestan el cambio entre pantallas clave."
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                <com.google.android.material.appbar.MaterialToolbar
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@color/primary_container"
                    app:title="Barra Superior de Muestra"
                    app:titleTextColor="@color/on_primary_container"
                    app:navigationIcon="@drawable/ic_containers" />

                <com.google.android.material.bottomnavigation.BottomNavigationView
                    android:id="@+id/miniBottomNav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:menu="@menu/bottom_nav_demo_menu" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
